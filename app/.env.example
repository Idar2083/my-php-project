# Application

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pizza_app_dev
DB_USERNAME=pizza_db_user
DB_PASSWORD=

# Session / Broadcast / Queue

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# Cache

CACHE_STORE=redis
# CACHE_PREFIX=

PRODUCTS_CACHE_TTL=3600

# Redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MEMCACHED_HOST=127.0.0.1

# RabbitMQ

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

RABBITMQ_CONNECT_TIMEOUT=5
RABBITMQ_READ_WRITE_TIMEOUT=10
RABBITMQ_HEARTBEAT=30
RABBITMQ_PREFETCH=1

# RabbitMQ / Reports

RABBITMQ_REPORTS_EXCHANGE=reports

RABBITMQ_REPORTS_GENERATE_QUEUE=reports.generate
RABBITMQ_REPORTS_GENERATE_ROUTING_KEY=reports.generate

RABBITMQ_REPORTS_RETRY_QUEUE=reports.generate.retry
RABBITMQ_REPORTS_RETRY_ROUTING_KEY=reports.generate.retry
RABBITMQ_REPORTS_RETRY_DELAY=5000

RABBITMQ_REPORTS_DLQ_QUEUE=reports.generate.dlq
RABBITMQ_REPORTS_DLQ_ROUTING_KEY=reports.generate.dlq

RABBITMQ_REPORTS_COMPLETED_QUEUE=reports.completed
RABBITMQ_REPORTS_COMPLETED_ROUTING_KEY=reports.completed

RABBITMQ_REPORTS_MAX_RETRIES=3

# Mail

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO / S3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=reports
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# JWT

JWT_SECRET=

# Vite

VITE_APP_NAME="${APP_NAME}"
