# Public API base path, including /api. No tokens or other secrets here.
# Default /api uses the same origin; the Vite dev proxy forwards to backend nginx.
# VITE_* is embedded by npm run build. Changing container runtime environment
# cannot change an already built bundle: rebuild with the desired value.
VITE_API_BASE_URL=/api

# Server-side dev proxy target; not exposed to the browser. Docker service name.
# For running Vite on the host, set this to the address of backend nginx.
API_PROXY_TARGET=http://nginx
